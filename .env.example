# Option A: Single database connection (backward compatible)
DATABASE_URL=postgresql://user:password@localhost:5432/mydb

# Option B: Multiple databases via numbered env vars (easiest)
# Type is auto-detected from the URL prefix (postgresql://, mysql://, mongodb://)
# DATABASE_URL1=postgresql://user:password@localhost:5432/mydb
# DATABASE_URL2=mysql://user:password@localhost:3306/mydb
# DATABASE_URL3=mongodb://localhost:27017/mydb
# Optional per-DB overrides:
# DB_NAME1=My Postgres
# DB_SCHEMA1=public
# MAX_ROWS1=1000

# Option C: Multiple databases via JSON (overrides DATABASE_URL)
# DATABASES=[{"id":"pg1","type":"postgres","url":"postgresql://user:pass@localhost:5432/mydb","name":"My PG","maxRows":500},{"id":"mongo1","type":"mongodb","url":"mongodb://localhost:27017/mydb","name":"My Mongo","maxRows":500}]

# AI provider: auto, gemini, or groq
AI_PROVIDER=auto

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# App
PORT=3001
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3000

# Optional: restrict which schema to expose
DB_SCHEMA=public

# Max rows returned per query
MAX_ROWS=500

# Response cache TTL in seconds (0 to disable). Caches exact duplicate
# (question + connection + schema fingerprint) to avoid repeat AI calls.
CACHE_TTL=300

# Semantic cache similarity threshold (0.0–1.0). When a semantically similar
# question (same meaning, different wording) is found above this threshold,
# the cached result is returned instead of calling the AI provider.
# Uses sqlite-vec (cosine distance) with Gemini embedding model.
# Requires GEMINI_API_KEY. Default: 0.92
CACHE_SIMILARITY_THRESHOLD=0.92
